{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rallie",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "env": {
    "dev": {
      "name": "rallie-dev",
      "vars": { "RUNTIME_ENV": "dev", "ALLOWED_ORIGINS": "http://127.0.0.1:8787,http://127.0.0.1:8788,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173", "MOCK_EXTRACTION": "false", "MOCK_TALLY": "false" },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "rallie-dev",
        // Local emulator placeholder, never a provisioned resource.
        "database_id": "00000000-0000-0000-0000-000000000001",
        "migrations_dir": "migrations"
      }]
    },
    "test": {
      "name": "rallie-test",
      "vars": { "RUNTIME_ENV": "test", "ALLOWED_ORIGINS": "http://127.0.0.1:8787,http://127.0.0.1:8789,http://127.0.0.1:5175", "MOCK_EXTRACTION": "false", "MOCK_TALLY": "false" },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "rallie-test",
        "database_id": "00000000-0000-0000-0000-000000000002",
        "migrations_dir": "migrations"
      }]
    },
    // Deliberately unprovisioned: never copy dev/test placeholder resources here.
    // Private target configuration and deployment are separate RAL-006 gates.
    "staging": {
      "name": "rallie-staging",
      "vars": { "RUNTIME_ENV": "staging", "MOCK_EXTRACTION": "false", "MOCK_TALLY": "false" }
    },
    "production": {
      "name": "rallie-production",
      "vars": { "RUNTIME_ENV": "production", "MOCK_EXTRACTION": "false", "MOCK_TALLY": "false" }
    }
  }
}